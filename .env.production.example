# ============================================================
# Engineers Platform — Production Environment Variables
# ============================================================
# Copy this file to .env.production and fill in real values.
# NEVER commit .env.production — it is gitignored.
# Run: docker compose --env-file .env.production -f docker-compose.prod.yml up --build -d
# ============================================================

# ── Domain ───────────────────────────────────────────────────
# Your domain pointed at the DigitalOcean droplet IP.
# Used by Nginx and Certbot for SSL certificate issuance.
DOMAIN=yourdomain.com

# ── PostgreSQL ───────────────────────────────────────────────
# REQUIRED — PostgreSQL superuser password.
# Use a strong random password: openssl rand -hex 32
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=engineers_platform

# ── Application ──────────────────────────────────────────────
# REQUIRED — JWT signing secret.
# Use a strong random secret: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_STRONG_JWT_SECRET
JWT_EXPIRES_IN=7d

# REQUIRED — Public URL of the client (used for CORS + email links).
# Must match DOMAIN above (with https://).
CLIENT_URL=https://yourdomain.com

# ── GitHub Scraper ───────────────────────────────────────────
# Optional. GitHub Personal Access Token for the company/repo scraper.
# Omit or leave blank to disable scraper (degrades gracefully).
GITHUB_TOKEN=

# ── AWS S3 (optional) ────────────────────────────────────────
# Leave blank to use the local mock upload URL in development.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# ── Elasticsearch ────────────────────────────────────────────
# Java heap size. Use 256m on small droplets (1-2 GB RAM).
# Use 512m or higher on droplets with >= 4 GB RAM.
ES_JAVA_OPTS=-Xms256m -Xmx256m

# ── Internal (do not change) ─────────────────────────────────
# These are set automatically inside docker-compose.prod.yml
# and do not need to be overridden here.
# DATABASE_URL is composed from POSTGRES_* variables in compose.
# REDIS_URL is set to redis://redis:6379 in compose.
# ELASTICSEARCH_NODE is set to http://elasticsearch:9200 in compose.
