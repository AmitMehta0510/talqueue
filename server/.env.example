DATABASE_URL=

JWT_SECRET=
JWT_EXPIRES_IN=7d

PORT=5000

GITHUB_TOKEN=

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200
# Optional security settings
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=

# Redis
REDIS_URL=redis://localhost:6379

# Brevo (transactional email — OTP delivery)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@engineers.dev
BREVO_SENDER_NAME=Engineers Platform

# Clearbit (optional — company metadata enrichment; falls back to Gemini+metatags without it)
CLEARBIT_API_KEY=

# Gemini (optional — AI-powered company description/tagline; skipped without it)
GEMINI_API_KEY=

# ── Job Scraping Pipeline v2 ─────────────────────────────────────────────────
#
# PIPELINE_V2_PRIMARY=true   → All ATS companies go through the production v2
#   pipeline (adapter → JobPipeline → JobPersister). Eliminates synthetic
#   getJobDescription() template fallbacks. Real descriptions or empty fields.
#   Set this when you're ready for full production cutover.
#
# PIPELINE_V2_PRIMARY=false  (default) → Existing v1 scraper path runs.
#   The v2 pipeline runs in shadow mode if PIPELINE_V2_SHADOW_MODE=true.
#
PIPELINE_V2_PRIMARY=false

# PIPELINE_V2_SHADOW_MODE=true → v2 pipeline runs in parallel with v1 (writes
#   ONLY to v2-specific DB columns: rawHtml, techStackJson, locationCity, etc.)
#   Does not touch v1 fields. Use for progressive validation before cutover.
#
PIPELINE_V2_SHADOW_MODE=false
