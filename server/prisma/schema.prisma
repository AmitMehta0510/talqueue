generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum EmploymentType {
  FULL_TIME
  INTERN
  FREELANCE
  CONTRACT
}

enum TrustLevel {
  BEGINNER
  EMERGING
  VERIFIED
  ADVANCED
  ELITE
}

enum PostType {
  GENERAL
  PROJECT_UPDATE
  EVENT
  HACKATHON
  ACHIEVEMENT

  COLLEGE
  DEPARTMENT
  PROJECT
  ANNOUNCEMENT
  JOB
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  FILE
  SYSTEM
}

enum CollegeMemberRole {
  MEMBER
  MODERATOR
  ADMIN
  ALUMNI
}

enum PostVisibility {
  PUBLIC
  CONNECTIONS
  COLLEGE_ONLY
  TEAM_ONLY
}

enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
  PROJECT_INVITE
  TEAM_INVITE
  REFERRAL
  JOB_APPLIED
  JOB_APPLICATION_UPDATE
  JOB_HIRED
  HACKATHON_JUDGING
  HACKATHON_WINNER
  SYSTEM
  POST_SHARED
  POST_MENTION
  COMMENT_MENTION
  COMMENT_REPLY
  POST_SAVED
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  MENTORSHIP
  MESSAGE
  COMMUNITY_JOINED
  PROJECT_JOIN_REQUEST
  PROJECT_JOIN_ACCEPTED
  PROJECT_JOIN_REJECTED
}

enum ProjectVisibility {
  PUBLIC
  PRIVATE
}

enum ProjectStatus {
  OPEN
  ACTIVE
  COMPLETED
  ARCHIVED
  DELETED
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

enum TeamStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum HackathonStatus {
  DRAFT
  OPEN
  LIVE
  ARCHIVED
  DELETED
  COMPLETED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum HackathonMode {
  ONLINE
  OFFLINE
  HYBRID
}

enum OrganizerType {
  COMPANY
  COLLEGE
  COMMUNITY
  STARTUP
  INDIVIDUAL
}

enum SubmissionStatus {
  PENDING
  UNDER_REVIEW
  SCORED
  WINNER
  REJECTED
}

enum ConversationType {
  DIRECT
  TEAM
  COLLEGE
  DEPARTMENT
  PROJECT
  HACKATHON
  COMMUNITY
  GROUP
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ReferralStatus {
  PENDING
  ACCEPTED
  REJECTED
  REFERRED
}

enum MentorshipStatus {
  PENDING
  ACTIVE
  REJECTED
  COMPLETED
}

enum ProjectInviteStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum CompanyType {
  STARTUP
  PRODUCT_BASED
  SERVICE_BASED
  ENTERPRISE
  MNC
  OTHER
}

enum CompanySize {
  SOLO
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}

enum JobType {
  FULL_TIME
  INTERNSHIP
  PART_TIME
  CONTRACT
  FREELANCE
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum JobStatus {
  OPEN
  CLOSED
  DRAFT
  ARCHIVED
  DELETED
}

enum JobApplicationStatus {
  APPLIED
  VIEWED
  SHORTLISTED
  INTERVIEW
  REJECTED
  HIRED
}

enum ActivityType {
  PROJECT_CREATED
  PROJECT_JOINED
  PROJECT_COMPLETED
  PROJECT_ARCHIVED

  TEAM_CREATED
  TEAM_JOINED

  HACKATHON_CREATED
  HACKATHON_REGISTERED
  HACKATHON_APPROVED
  HACKATHON_REJECTED
  HACKATHON_SUBMITTED
  HACKATHON_WON

  JOB_POSTED
  JOB_APPLIED
  JOB_SHORTLISTED
  JOB_INTERVIEW
  JOB_HIRED
  JOB_ARCHIVED
  JOB_DELETED

  HACKATHON_JUDGE_ASSIGNED
  HACKATHON_SUBMISSION_REVIEWED
  HACKATHON_WINNER_DECLARED

  REFERRAL_RECEIVED
  REFERRAL_GIVEN

  MENTORSHIP_STARTED

  POST_CREATED
  POST_SHARED
  COMMENT_CREATED

  COLLEGE_JOINED
  COMMUNITY_JOINED
  COMMUNITY_CREATED
  COMMUNITY_ARCHIVED

  CONNECTION_REQUEST_SENT
  CONNECTION_ACCEPTED
  USER_FOLLOWED

  MESSAGE_SENT

  REPUTATION_MILESTONE
  EXPERIENCE_ADDED
}

enum BadgeCategory {
  PROJECT
  TEAM
  HACKATHON
  JOB
  REFERRAL
  RECRUITER
  MENTORSHIP
  JUDGING
  SOCIAL
  REPUTATION
  SPECIAL
}

enum BadgeRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum RepoVisibility {
  PUBLIC
  PRIVATE
}

enum DeploymentStatus {
  LIVE
  DEVELOPMENT
  ARCHIVED
}

enum FeedItemType {
  POST
  PROJECT
  HACKATHON
  JOB
  COMPANY
  PROFILE
  COLLEGE
  TEAM
  COMMUNITY
}

enum FeedInteractionType {
  VIEW
  CLICK
  LIKE
  COMMENT
  SAVE
  SHARE
  APPLY
  OPEN_PROJECT
  OPEN_PROFILE
  JOIN_COMMUNITY
  LEAVE_COMMUNITY
}

enum CommunityType {
  COLLEGE
  COMPANY
  GENERAL
}

enum CommunityVisibility {
  PUBLIC
  PRIVATE
  RESTRICTED
}

enum CommunityMemberRole {
  MEMBER
  MODERATOR
  ADMIN
  OWNER
}

enum CommunityCategory {
  GENERAL

  CODING

  PLACEMENTS

  INTERNSHIPS

  REFERRALS

  INTERVIEWS

  SALARIES

  ANNOUNCEMENTS

  RESOURCES

  EVENTS

  STARTUPS

  OPEN_SOURCE

  AI

  CAREER_GUIDANCE
}

model User {
  id       String     @id @default(uuid())
  email    String     @unique
  username String     @unique
  password String
  status   UserStatus @default(ACTIVE)

  followers Follow[] @relation("following")

  following Follow[] @relation("follower")

  followersCount Int @default(0)
  followingCount Int @default(0)

  connectionCount Int @default(0)

  postCount Int @default(0)

  profileCompleteness Float @default(0)

  lastActiveAt DateTime?

  verifiedEngineer Boolean @default(false)

  availabilityStatus String?

  sentConnections Connection[] @relation("connectionSender")

  receivedConnections Connection[] @relation("connectionReceiver")

  sentReferralRequests ReferralRequest[] @relation("referralRequester")

  receivedReferralRequests ReferralRequest[] @relation("referralReceiver")

  sentMentorshipRequests MentorshipRequest[] @relation("mentorshipRequester")

  receivedMentorshipRequests MentorshipRequest[] @relation("mentor")

  receivedProjectInvites ProjectInvite[] @relation("projectInvitedUser")

  sentProjectInvites ProjectInvite[] @relation("projectInvitedBy")

  affinities UserAffinity[] @relation("userAffinitySource")

  targetAffinities UserAffinity[] @relation("userAffinityTarget")

  feedInteractions FeedInteraction[]

  interestProfile UserInterestProfile?

  profileViewsGiven ProfileView[] @relation("profileViewer")

  profileViewsReceived ProfileView[] @relation("profileViewed")

  projectViews ProjectView[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile              Profile?
  roles                UserRole[]
  skills               UserSkill[]
  experiences          Experience[]
  educations           Education[]
  codingProfiles       CodingProfile[]
  communityMemberships CommunityMember[]

  recommendationImpressions RecommendationImpression[]

  feedAnalytics FeedAnalytics[]

  recommendationSnapshots RecommendationSnapshot[]

  posts    Post[]
  comments Comment[]
  likes    Like[]

  activities EngineeringActivity[]

  notifications Notification[]

  createdHackathons   Hackathon[]
  judgeAssignments    HackathonJudge[]
  ownedProjects       Project[]
  projectMemberships  ProjectMember[]
  projectJoinRequests ProjectJoinRequest[]

  ownedTeams      Team[]
  teamMemberships TeamMember[]

  receivedInvites TeamInvite[]  @relation("invitedUser")
  sentInvites     TeamInvite[]  @relation("invitedBy")
  presence        UserPresence?

  postedJobs      Job[]
  jobApplications JobApplication[]
  savedJobs       SavedJob[]

  reputationScore   Int        @default(0)
  engineeringScore  Float      @default(0)
  trustLevel        TrustLevel @default(BEGINNER)
  featuredProjectId String?

  searchScore Float @default(0)

  searchVisibility Boolean @default(true)

  acceptingCollaborators Boolean @default(true)

  acceptingReferrals Boolean @default(false)

  acceptingMentorship Boolean @default(false)

  primaryRole String?

  openToWork Boolean @default(false)

  openToInternship Boolean @default(false)

  badges UserBadge[]

  reputationEvents ReputationEvent[]

  conversationParticipants ConversationParticipant[]
  createdConversations     Conversation[]            @relation("ConversationCreator")
  sentNotifications        Notification[]            @relation("notificationActor")
  recommendationsGiven     UserRecommendation[]      @relation("recommendationSource")

  recommendationsReceived UserRecommendation[] @relation("recommendationTarget")

  sentMessages     Message[]
  postShares       PostShare[]
  savedPosts       SavedPost[]
  messageReactions MessageReaction[]

  // Admin assignments
  collegeAdminGrants   CollegeAdmin[]     @relation("CollegeAdminGrantor")
  collegeAdminships    CollegeAdmin[]     @relation("CollegeAdminUser")
  companyAdminGrants   CompanyAdmin[]     @relation("CompanyAdminGrantor")
  companyAdminships    CompanyAdmin[]     @relation("CompanyAdminUser")
  createdCommunities   Community[]        @relation("CommunityCreator")
  companyRequests      CompanyRequest[]
  collegeRequests      CollegeRequest[]
}

model UserRecommendation {
  id String @id @default(uuid())

  userId String

  recommendedUserId String

  recommendationType String

  score Float

  reason String?

  clicked Boolean @default(false)

  dismissed Boolean @default(false)

  createdAt DateTime @default(now())

  user User @relation("recommendationSource", fields: [userId], references: [id], onDelete: Cascade)

  recommendedUser User @relation("recommendationTarget", fields: [recommendedUserId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Role {
  id   String @id @default(uuid())
  name String @unique

  users UserRole[]

  createdAt DateTime @default(now())
}

model UserRole {
  id String @id @default(uuid())

  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, roleId])
}

model Profile {
  id String @id @default(uuid())

  userId   String  @unique
  fullName String
  bio      String?

  avatarUrl String?

  headline String?

  location String?

  resumeUrl String?

  bannerUrl String?

  availabilityText String?

  githubUrl    String?
  linkedinUrl  String?
  portfolioUrl String?

  collegeId    String?
  departmentId String?

  graduationYear Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  college College? @relation(fields: [collegeId], references: [id])

  department Department? @relation(fields: [departmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([collegeId])
  @@index([departmentId])
}

model CodingProfile {
  id String @id @default(uuid())

  userId String

  platform String
  url      String
  username String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

model College {
  id String @id @default(uuid())

  name    String
  state   String?
  city    String?
  country String?

  website String?
  logoUrl String?

  departments Department[]
  profiles    Profile[]
  educations  Education[]

  normalizedKey String @unique

  communities Community[]

  collegeAdmins CollegeAdmin[]

  createdAt     DateTime       @default(now())
  posts         Post[]
  conversations Conversation[]

  @@index([name])
  @@index([city])
  @@index([state])
  @@index([country])
}

model Department {
  id String @id @default(uuid())

  name String

  // Head of Department (display name, not necessarily a platform user)
  hod String?

  collegeId String
  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  profiles   Profile[]
  educations Education[]

  createdAt     DateTime       @default(now())
  posts         Post[]
  conversations Conversation[]
  communities   Community[]

  @@index([collegeId])
  @@index([collegeId, name])
}

model Skill {
  id          String      @id @default(uuid())
  name        String      @unique
  category    String?
  searchScore Float       @default(0)
  verified    Boolean     @default(false)
  users       UserSkill[]
  createdAt   DateTime    @default(now())
}

model UserSkill {
  id String @id @default(uuid())

  userId  String
  skillId String

  level SkillLevel @default(BEGINNER)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, skillId])
  @@index([skillId])
}

model Experience {
  id String @id @default(uuid())

  userId String

  companyId String

  companyName String?

  title String

  employmentType EmploymentType

  startDate DateTime

  endDate DateTime?

  isCurrent Boolean @default(false)

  description String?

  //
  // AUTHENTICITY
  //
  verified Boolean @default(false)

  verificationScore Float @default(0)

  verifiedAt DateTime?

  workEmail String?

  workEmailVerified Boolean @default(false)

  managerName String?

  managerLinkedinUrl String?

  managerEmail String?

  documents Json?

  verificationNotes String?

  verificationMethod String?

  //
  // EXPERIENCE SIGNALS
  //
  skillsUsed Json?

  achievements Json?

  techStack Json?

  teamSize Int?

  //
  // ANTI FRAUD
  //
  suspicious Boolean @default(false)

  flaggedReason String?

  //
  // RELATIONS
  //
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
  @@index([companyId])
  @@index([userId, employmentType, startDate, endDate])
}

model Education {
  id String @id @default(uuid())

  userId String

  collegeId    String?
  departmentId String?

  // Freetext name used when user's college is not yet in the DB
  customCollegeName String?

  degree       String?
  fieldOfStudy String?

  startYear Int?
  endYear   Int?

  current Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  college College? @relation(fields: [collegeId], references: [id])

  department Department? @relation(fields: [departmentId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([collegeId])
  @@index([departmentId])
  @@index([userId, collegeId, departmentId])
}

enum CollegeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  DUPLICATE
}

model CollegeRequest {
  id      String               @id @default(uuid())
  userId  String
  name    String
  city    String?
  state   String?
  country String?
  website String?

  status    CollegeRequestStatus @default(PENDING)
  adminNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([name])
}

model Post {
  id String @id @default(uuid())

  authorId String

  content String

  type PostType

  announcement Boolean @default(false)
  anonymous    Boolean @default(false)

  discoverable Boolean @default(true)

  resourceUrl  String?
  resourceType String?

  // MEDIA

  media       Json?
  attachments Json?

  thumbnailUrl String?

  tags PostTag[]

  mentions String[]

  // CONTEXT
  collegeId    String?
  departmentId String?
  communityId  String?

  projectId   String?
  hackathonId String?

  // VISIBILITY
  visibility PostVisibility @default(PUBLIC)

  featured Boolean @default(false)

  pinned Boolean @default(false)

  archivedAt DateTime?
  deletedAt  DateTime?

  // ANALYTICS
  shareCount Int @default(0)

  saveCount Int @default(0)

  commentsCount Int @default(0)
  likesCount    Int @default(0)

  impressionCount Int @default(0)

  engagementScore Float @default(0)

  trendingScore Float @default(0)

  // RELATIONS

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  college College? @relation(fields: [collegeId], references: [id])

  department Department? @relation(fields: [departmentId], references: [id])

  project Project? @relation(fields: [projectId], references: [id])

  hackathon Hackathon? @relation(fields: [hackathonId], references: [id])

  comments Comment[]
  likes    Like[]
  shares   PostShare[]
  savedBy  SavedPost[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  community Community? @relation(fields: [communityId], references: [id])

  @@index([authorId])
  @@index([collegeId])
  @@index([departmentId])
  @@index([createdAt])
  @@index([trendingScore])
  @@index([communityId])
}

model PostShare {
  id String @id @default(uuid())

  postId String
  userId String

  caption String?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model SavedPost {
  id String @id @default(uuid())

  userId String
  postId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model PostTag {
  id String @id @default(uuid())

  postId String

  tag String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([tag])
}

model Comment {
  id String @id @default(uuid())

  postId String

  authorId String

  content String

  media Json?

  attachments Json?

  mentions String[]

  parentCommentId String?

  editedAt  DateTime?
  deletedAt DateTime?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  parentComment Comment? @relation("CommentReplies", fields: [parentCommentId], references: [id])

  replies Comment[] @relation("CommentReplies")

  createdAt DateTime @default(now())

  @@index([postId])
}

model Like {
  id String @id @default(uuid())

  postId String
  userId String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model Notification {
  id String @id @default(uuid())

  //
  // RECEIVER
  //
  userId String

  //
  // ACTOR
  //
  actorId String?

  //
  // TYPE
  //
  type NotificationType

  //
  // CONTENT
  //
  title   String
  message String

  //
  // ENTITY CONTEXT
  //
  entityType String?
  entityId   String?

  //
  // DEEP LINK
  //
  actionUrl String?

  //
  // EXTRA DATA
  //
  metadata Json?

  //
  // STATE
  //
  isRead Boolean @default(false)

  readAt DateTime?

  archived Boolean @default(false)

  //
  // GROUPING
  //
  groupKey String?

  //
  // RELATIONS
  //
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  actor User? @relation("notificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([actorId])
  @@index([type])
  @@index([createdAt])
  @@index([isRead])
}

model Project {
  id String @id @default(uuid())

  ownerId String

  teamId String?

  team Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  title String

  slug String? @unique

  description String

  shortDescription String?

  //
  // AUTHENTICITY
  //
  githubUrl String?

  liveUrl String?

  videoDemoUrl String?

  screenshots Json?

  techStack Json?

  repoVisibility RepoVisibility?

  deploymentStatus DeploymentStatus? @default(DEVELOPMENT)

  featured Boolean @default(false)

  verified Boolean @default(false)

  engineeringScore Float @default(0)

  //
  // GITHUB METADATA
  //
  starsCount Int @default(0)

  forksCount Int @default(0)

  commitCount Int @default(0)

  contributorsCount Int @default(0)

  openIssuesCount Int @default(0)

  pullRequestsCount Int @default(0)

  primaryLanguage String?

  languages Json?

  repoCreatedAt DateTime?

  repoUpdatedAt DateTime?

  lastGithubSyncAt DateTime?

  //
  // EXISTING FIELDS
  //
  visibility ProjectVisibility @default(PUBLIC)

  status ProjectStatus @default(OPEN)

  lookingFor String?

  searchScore Float @default(0)

  trendingScore Float @default(0)

  collaborationScore Float @default(0)

  searchTags String[]

  difficultyLevel String?

  domain String?

  //
  // RELATIONS
  //
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  invites ProjectInvite[]

  requiredRoles ProjectRoleRequirement[]

  members ProjectMember[]

  joinRequests ProjectJoinRequest[]

  hackathonSubmissions HackathonSubmission[]

  //
  // TIMESTAMPS
  //
  createdAt DateTime @default(now())

  completedAt DateTime?

  archivedAt DateTime?

  deletedAt DateTime?

  updatedAt     DateTime       @updatedAt
  projectViews  ProjectView[]
  posts         Post[]
  conversations Conversation[]
}

model ProjectRoleRequirement {
  id String @id @default(uuid())

  projectId String

  title       String
  description String?

  slots Int @default(1)

  filledSlots Int @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model ProjectMember {
  id String @id @default(uuid())

  projectId String
  userId    String

  role TeamRole @default(MEMBER)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

model ProjectJoinRequest {
  id String @id @default(uuid())

  projectId String
  userId    String

  message String?

  status InviteStatus @default(PENDING)

  reviewedAt  DateTime?
  withdrawnAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model ProjectInvite {
  id String @id @default(uuid())

  projectId String

  invitedUserId String

  invitedById String

  message String?

  status ProjectInviteStatus @default(PENDING)

  reviewedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  invitedUser User @relation("projectInvitedUser", fields: [invitedUserId], references: [id], onDelete: Cascade)

  invitedBy User @relation("projectInvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([projectId, invitedUserId])
}

model Team {
  id String @id @default(uuid())

  name        String
  description String?

  ownerId String

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  members TeamMember[]

  conversations Conversation[]

  invites TeamInvite[]

  projects Project[]

  hackathonRegistrations HackathonRegistration[]

  hackathonSubmissions HackathonSubmission[]

  hackathonWins HackathonWinner[]

  reputationScore Int @default(0)

  completedProjectsCount Int @default(0)

  hackathonWinsCount Int @default(0)

  createdAt DateTime @default(now())

  status     TeamStatus @default(ACTIVE)
  archivedAt DateTime?
