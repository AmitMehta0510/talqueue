model PlacementDriveRoundShortlist {
  id            String   @id @default(uuid())
  roundId       String
  applicationId String
  advancedAt    DateTime @default(now())
  round         PlacementDriveRound       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  application   PlacementDriveApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@unique([roundId, applicationId])
}

model CompanyOffice {
