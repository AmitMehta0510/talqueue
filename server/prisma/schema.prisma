// ADMIN DELEGATION
// ============================================================

model CollegeAdmin {
  id          String   @id @default(uuid())
  userId      String
  collegeId   String
  grantedById String
  createdAt   DateTime @default(now())

  user      User    @relation("CollegeAdminUser", fields: [userId], references: [id], onDelete: Cascade)
  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  grantedBy User    @relation("CollegeAdminGrantor", fields: [grantedById], references: [id])

  @@unique([userId, collegeId])
  @@index([collegeId])
  @@index([userId])
}

model CdcrMember {
  id           String   @id @default(uuid())
  userId       String
  collegeId    String
  assignedById String
  createdAt    DateTime @default(now())

  // ── Scope field ──────────────────────────────────────────────────────────
  // departmentId is optional: null = college-wide CDCR (assigned by TPO),
  // set = department-scoped CDCR (assigned by HOD of that department).
  departmentId String?

  user       User       @relation("CdcrMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  college    College    @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  assignedBy User       @relation("CdcrMemberAssignedBy", fields: [assignedById], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  // Note: PostgreSQL unique index allows multiple nulls in departmentId.
  // We enforce true uniqueness for college-wide members (null departmentId)
  // via a custom partial unique index in a migration:
  // CREATE UNIQUE INDEX cdcr_legacy_college_wide_idx ON "CdcrMember" ("userId", "collegeId") WHERE "departmentId" IS NULL;
  @@unique([userId, collegeId, departmentId])
  @@index([collegeId])
  @@index([userId])
  @@index([departmentId])
}

model CompanyAdmin {
  id          String   @id @default(uuid())
  userId      String
  companyId   String
  // null = admin for entire company; set to city for office-scoped admin
  officeCity  String?
  grantedById String
  createdAt   DateTime @default(now())

  user      User    @relation("CompanyAdminUser", fields: [userId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  grantedBy User    @relation("CompanyAdminGrantor", fields: [grantedById], references: [id])

  @@unique([userId, companyId, officeCity])
  @@index([companyId])
  @@index([userId])
}

enum EventType {
  COLLEGE
  COMPANY
  GENERAL
}

enum RSVPStatus {
  GOING
  MAYBE
  DECLINED
}

model Event {
  id            String       @id @default(uuid())
  title         String
  description   String?
  startDate     DateTime
  endDate       DateTime
  location      String?
  meetingUrl    String?
  capacity      Int?
  type          EventType    @default(GENERAL)
  collegeId     String?
  companyId     String?
  communityId   String?
  createdById   String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  createdBy     User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  college       College?     @relation(fields: [collegeId], references: [id])
  company       Company?     @relation(fields: [companyId], references: [id])
  community     Community?   @relation(fields: [communityId], references: [id])
  rsvps         EventRSVP[]

  @@index([collegeId])
  @@index([companyId])
  @@index([communityId])
  // Composite indexes for filtered event queries
  @@index([collegeId, type])
  @@index([companyId, type])
  @@index([startDate])
}

model EventRSVP {
  id        String     @id @default(uuid())
  eventId   String
  userId    String
  status    RSVPStatus @default(GOING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model StandardDepartment {
  id          String       @id @default(uuid())
  name        String       @unique
  aliases     String[]
  departments Department[]
}

model ExternalJobApplication {
  id             String            @id @default(uuid())
  userId         String
  jobId          String?

  jobTitle       String
  companyName    String
  companyLogoUrl String?
  applyUrl       String?
  location       String?
  jobType        String?

  status         ExternalAppStatus @default(APPLIED)
  notes          String?
  appliedAt      DateTime          @default(now())

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  job            Job?              @relation(fields: [jobId], references: [id], onDelete: SetNull)

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([id, userId])
  @@index([userId])
  @@index([jobId])
}

model PlacementDrive {
  id               String               @id @default(uuid())
  driveTitle       String
  companyId        String
  targetCollegeId  String
  postedById       String

  driveDate        DateTime?
  applyDeadline    DateTime?
  status           PlacementDriveStatus @default(UPCOMING)
  driveType        PlacementDriveType   @default(PLACEMENT)

  roles            String[]
  stipendMin       Int?
  stipendMax       Int?
  salaryMin        Int?
  salaryMax        Int?
  currency         String?              @default("INR")
  internshipDurationMonths Int?         // Only for INTERNSHIP type drives

  minCgpa          Float?
  maxBacklogs      Int?                 // Max allowed backlogs (null = use college policy)
  eligibleBranches String[]
  eligibleYears    Int[]

  isDreamCompany   Boolean              @default(false) // Exempt from ONE_OFFER_LOCK policy
  ppoOffered       Boolean              @default(false) // Internship drive that may convert to full-time PPO
  description      String?

  company          Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  college          College              @relation(fields: [targetCollegeId], references: [id], onDelete: Cascade)
  postedBy         User                 @relation(fields: [postedById], references: [id], onDelete: Cascade)

  applications     PlacementDriveApplication[]
  invite           PlacementDriveInvite?
  rounds           PlacementDriveRound[]

  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([targetCollegeId])
  @@index([companyId])
  @@index([status])
  @@index([driveType])
}

model PlacementDriveApplication {
  id        String                        @id @default(uuid())
  driveId   String
  userId    String
  note      String?
  status    PlacementDriveApplicationStatus @default(APPLIED)
  appliedAt DateTime                      @default(now())

  drive PlacementDrive @relation(fields: [driveId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  roundShortlists PlacementDriveRoundShortlist[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([driveId, userId])
  @@index([userId])
  @@index([driveId])
  @@index([status])
}

model PlacementDriveInvite {
  id          String                       @id @default(uuid())
  companyId   String
  collegeId   String
  initiatedBy PlacementDriveInviteDirection @default(COMPANY_TO_COLLEGE)

  driveTitle       String
  driveDate        DateTime?
  applyDeadline    DateTime?
  roles            String[]
  stipendMin       Int?
  stipendMax       Int?
  salaryMin        Int?
  salaryMax        Int?
  currency         String?  @default("INR")
  minCgpa          Float?
  eligibleBranches String[]
  eligibleYears    Int[]
  description      String?

  message    String?
  status     PlacementDriveInviteStatus @default(PENDING)
  reviewedAt DateTime?

  createdById      String
  placementDriveId String? @unique

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  college        College         @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  createdBy      User            @relation("PlacementDriveInviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  placementDrive PlacementDrive? @relation(fields: [placementDriveId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([collegeId])
  @@index([status])
}

model PlacementDriveRound {
  id          String   @id @default(uuid())
  driveId     String
  roundNumber Int
  roundType   String   // "APTITUDE_TEST" | "GROUP_DISCUSSION" | "TECHNICAL_INTERVIEW" | "HR_INTERVIEW" | "FINAL"
  scheduledAt DateTime?
  venue       String?
  meetLink    String?
  durationMin Int?
  maxSlots    Int?
  notes       String?
  drive       PlacementDrive @relation(fields: [driveId], references: [id], onDelete: Cascade)
  shortlistedApplications PlacementDriveRoundShortlist[]
  createdAt   DateTime @default(now())
  @@index([driveId])
