  grantedById String
  createdAt   DateTime @default(now())

  user      User    @relation("CompanyAdminUser", fields: [userId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  grantedBy User    @relation("CompanyAdminGrantor", fields: [grantedById], references: [id])

  @@unique([userId, companyId, officeCity])
  @@index([companyId])
  @@index([userId])
}
