model Community {
  id String @id @default(uuid())

  // CORE
  name String

  slug String @unique

  description String?

  shortDescription String?

  avatarUrl String?

  bannerUrl String?

  type CommunityType

  category CommunityCategory

  visibility CommunityVisibility @default(PUBLIC)

  verified Boolean @default(false)

  archived Boolean @default(false)
  archivedAt DateTime?
  deletedAt  DateTime?

  searchable Boolean @default(true)

  featured Boolean @default(false)

  // ANALYTICS
  memberCount Int @default(0)

  postCount Int @default(0)

  conversationCount Int @default(0)

  activityScore Float @default(0)

  trendingScore Float @default(0)

  // COLLEGE CONTEXT
  collegeId String?

  departmentId String?

  // COMPANY CONTEXT
  companyId String?

  city String?

  state String?

  country String?

  // GENERAL COMMUNITY
  tags String[]

  searchKeywords String[]

  // ACCESS CONTROL
  autoJoinEligible Boolean @default(false)

  joinApprovalRequired Boolean @default(false)

  allowExternalView Boolean @default(true)

  // RELATIONS
  college College? @relation(fields: [collegeId], references: [id])

  department Department? @relation(fields: [departmentId], references: [id])

  company Company? @relation(fields: [companyId], references: [id])

  members CommunityMember[]

  posts Post[]

  conversations Conversation[]
  events        Event[]

  createdById String
  createdBy   User   @relation("CommunityCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // UNIQUE CONSTRAINTS

  // ONE COMMUNITY TYPE Example: IITB + CODING

  @@unique([collegeId, category, slug])
  // GOOGLE BANGALORE REFERRALS
  @@unique([companyId, city, category, slug])
  // INDEXES
  @@index([type])
  @@index([category])
  @@index([collegeId])
  @@index([companyId])
  @@index([collegeId, departmentId, autoJoinEligible])
  @@index([companyId, autoJoinEligible])
  @@index([visibility])
  @@index([activityScore])
  @@index([trendingScore])
  @@index([createdAt])
}

model CommunityMember {
  id String @id @default(uuid())

  communityId String

  userId String

  role CommunityMemberRole @default(MEMBER)

  verified Boolean @default(false)

  active Boolean @default(true)

  muted Boolean @default(false)

  pinned Boolean @default(false)

  archived Boolean @default(false)

  autoJoined Boolean @default(false)

  contributionScore Float @default(0)

  reputationScore Float @default(0)

  joinedAt DateTime @default(now())

  lastActiveAt DateTime?

  leftAt DateTime?

  // RELATIONS
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // INDEXES
  @@unique([communityId, userId])
  @@index([userId])
  @@index([userId, active])
  @@index([communityId])
  @@index([role])
  @@index([active])
}

