// ADVERTISING & PROMOTIONS
// ---------------------------------------------------------------------------

model AdPlacement {
  id            String          @id @default(uuid())
  title         String
  bannerUrl     String?
  redirectUrl   String
  placementType AdPlacementType
  impressions   Int             @default(0)
  clicks        Int             @default(0)
  isActive      Boolean         @default(true)
  priority      Int             @default(0)
  budgetInPaisa Int?
  expiresAt     DateTime?
  targetSkills  String[]        @default([])

  // College-specific targeting (optional)
  targetCollegeId String?
  targetCollege   College? @relation(fields: [targetCollegeId], references: [id], onDelete: SetNull)

  // Self-serve ad creation by a recruiter/company
  createdByCompanyId String?
  createdByCompany   Company? @relation(fields: [createdByCompanyId], references: [id], onDelete: SetNull)

  // For SPONSORED_JOB type: links to existing Job record (zero data duplication)
  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, placementType])
  @@index([targetCollegeId])
  @@index([expiresAt])
  @@index([createdByCompanyId])
}

// ---------------------------------------------------------------------------
// INTERVIEW MODULE — PHASE 1: AGGREGATED CONTENT
// ---------------------------------------------------------------------------

model InterviewResource {
  id           String   @id @default(uuid())

  // Core metadata — zero storage cost (video hosted on YouTube)
  title        String
  sourceUrl    String   @unique      // canonical YouTube URL
  youtubeId    String   @unique      // extracted video ID for embed

  channelName  String?               // e.g. "NeetCode", "TechLead"
  thumbnailUrl String?               // YouTube thumbnail CDN URL (not stored by us)
  duration     Int?                  // seconds

  // Filter dimensions
  roleTag      InterviewRoleTag
  difficulty   InterviewDifficulty
  companyTag   InterviewCompanyTag  @default(ANY)
  roundType    InterviewRoundType?
  langTags     String[]             @default([])  // e.g. ["Node.js", "Spring Boot"]
  formatTag    InterviewFormatTag?

  // Governance
  isActive     Boolean  @default(true)
  addedById    String?              // userId of PLATFORM_ADMIN (null = cron-seeded)

  // Relations
  rooms        InterviewRoom[]
  savedBy      SavedInterviewResource[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([roleTag])
  @@index([difficulty])
  @@index([companyTag])
  @@index([roundType])
  @@index([isActive, roleTag, difficulty])
  @@index([isActive, companyTag])
}

model SavedInterviewResource {
  id         String   @id @default(uuid())
  userId     String
  resourceId String

  user       User              @relation(fields: [userId],     references: [id], onDelete: Cascade)
  resource   InterviewResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@unique([userId, resourceId])
  @@index([userId])
  @@index([resourceId])
}

// ---------------------------------------------------------------------------
// INTERVIEW MODULE — PHASE 2 STUB: LIVE P2P ROOMS
// All live-session fields are nullable so Phase 1 rows carry zero overhead.
// ---------------------------------------------------------------------------

model InterviewRoom {
  id          String              @id @default(uuid())

  // Lifecycle
  status      InterviewRoomStatus @default(SCHEDULED)

  // Participants (populated in Phase 2)
  hostId      String?
  guestId     String?

  // WebRTC signaling token (populated in Phase 2)
  webrtcToken String?

  // Scheduling & timing
  scheduledAt DateTime?
  startedAt   DateTime?
  endedAt     DateTime?

  // AI feedback loop (Phase 2)
  aiFeedback  Json?

  // Optional link to an aggregated resource that seeded this room
  resourceId  String?

  host        User?              @relation("RoomHost",  fields: [hostId],     references: [id], onDelete: SetNull)
  guest       User?              @relation("RoomGuest", fields: [guestId],    references: [id], onDelete: SetNull)
  resource    InterviewResource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([hostId])
  @@index([guestId])
  @@index([resourceId])
}
