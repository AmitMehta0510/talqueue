model User {
  id       String     @id @default(uuid())
  email    String     @unique
  username String     @unique
  password String
  status   UserStatus @default(ACTIVE)

  followers Follow[] @relation("following")

  following Follow[] @relation("follower")

  followersCount Int @default(0)
  followingCount Int @default(0)

  connectionCount Int @default(0)

  postCount Int @default(0)

  profileCompleteness Float @default(0)

  lastActiveAt DateTime?

  verifiedEngineer Boolean @default(false)
  isEmailVerified Boolean @default(false)

  availabilityStatus String?

  sentConnections Connection[] @relation("connectionSender")

  receivedConnections Connection[] @relation("connectionReceiver")

  sentReferralRequests ReferralRequest[] @relation("referralRequester")

  receivedReferralRequests ReferralRequest[] @relation("referralReceiver")

  sentMentorshipRequests MentorshipRequest[] @relation("mentorshipRequester")

  receivedMentorshipRequests MentorshipRequest[] @relation("mentor")

  receivedProjectInvites ProjectInvite[] @relation("projectInvitedUser")

  sentProjectInvites ProjectInvite[] @relation("projectInvitedBy")

  affinities UserAffinity[] @relation("userAffinitySource")

  targetAffinities UserAffinity[] @relation("userAffinityTarget")

  feedInteractions FeedInteraction[]

  interestProfile UserInterestProfile?

  profileViewsGiven ProfileView[] @relation("profileViewer")

  profileViewsReceived ProfileView[] @relation("profileViewed")

  projectViews ProjectView[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile              Profile?
  roles                UserRole[]
  skills               UserSkill[]
  experiences          Experience[]
  educations           Education[]
  codingProfiles       CodingProfile[]
  communityMemberships CommunityMember[]

  recommendationImpressions RecommendationImpression[]

  feedAnalytics FeedAnalytics[]

  recommendationSnapshots RecommendationSnapshot[]

  posts    Post[]
  comments Comment[]
  likes    Like[]

  activities EngineeringActivity[]

  notifications Notification[]

  createdHackathons   Hackathon[]
  judgeAssignments    HackathonJudge[]
  ownedProjects       Project[]
  projectMemberships  ProjectMember[]
  projectJoinRequests ProjectJoinRequest[]

  ownedTeams      Team[]
  teamMemberships TeamMember[]

  receivedInvites TeamInvite[]  @relation("invitedUser")
  sentInvites     TeamInvite[]  @relation("invitedBy")
  presence        UserPresence?

  postedJobs      Job[]
  jobApplications JobApplication[]
  savedJobs       SavedJob[]

  reputationScore   Int        @default(0)
  engineeringScore  Float      @default(0)
  trustLevel        TrustLevel @default(BEGINNER)
  featuredProjectId String?

  searchScore Float @default(0)

  searchVisibility Boolean @default(true)

  acceptingCollaborators Boolean @default(true)

  acceptingReferrals Boolean @default(false)

  acceptingMentorship Boolean @default(false)

  primaryRole String?

  openToWork Boolean @default(false)

  openToInternship Boolean @default(false)

  // ── Monetization & Access Control ────────────────────────────────────────
  tier                        UserTier @default(FREE)
  dailyReferralCount          Int      @default(0)
  maxDailyReferrals           Int      @default(5)
  canAccessRecruiterDirectory Boolean  @default(false)

  badges UserBadge[]

  reputationEvents ReputationEvent[]

  conversationParticipants ConversationParticipant[]
  createdConversations     Conversation[]            @relation("ConversationCreator")
  sentNotifications        Notification[]            @relation("notificationActor")
  recommendationsGiven     UserRecommendation[]      @relation("recommendationSource")

  recommendationsReceived UserRecommendation[] @relation("recommendationTarget")

  sentMessages     Message[]
  postShares       PostShare[]
  savedPosts       SavedPost[]
  messageReactions MessageReaction[]

  // Admin assignments
  collegeAdminGrants   CollegeAdmin[]     @relation("CollegeAdminGrantor")
  collegeAdminships    CollegeAdmin[]     @relation("CollegeAdminUser")
  companyAdminGrants   CompanyAdmin[]     @relation("CompanyAdminGrantor")
  companyAdminships    CompanyAdmin[]     @relation("CompanyAdminUser")
  cdcrMemberships      CdcrMember[]       @relation("CdcrMemberUser")
  cdcrAssignments      CdcrMember[]       @relation("CdcrMemberAssignedBy")
  createdCommunities   Community[]        @relation("CommunityCreator")
  companyRequests      CompanyRequest[]
  collegeRequests      CollegeRequest[]
  // Institutional governance back-relations
  masterAdminColleges  College[]          @relation("CollegeMasterAdmin")
  tpoColleges          College[]          @relation("CollegeTpo")
  hodDepartments       Department[]       @relation("DepartmentHod")
  followedCompanies        Company[]                   @relation("CompanyFollowers")
  createdEvents            Event[]
  eventRSVPs               EventRSVP[]
  externalApplications            ExternalJobApplication[]
  postedPlacementDrives           PlacementDrive[]
  placementDriveApplications      PlacementDriveApplication[]
  placementDriveInvitesCreated    PlacementDriveInvite[]      @relation("PlacementDriveInviteCreator")

  // Interview Module
  savedInterviewResources         SavedInterviewResource[]
  hostedRooms                     InterviewRoom[]             @relation("RoomHost")
  guestRooms                      InterviewRoom[]             @relation("RoomGuest")
}

model UserRecommendation {
  id String @id @default(uuid())

  userId String

  recommendedUserId String

  recommendationType String

  score Float

  reason String?

  clicked Boolean @default(false)

  dismissed Boolean @default(false)

  createdAt DateTime @default(now())

  user User @relation("recommendationSource", fields: [userId], references: [id], onDelete: Cascade)

  recommendedUser User @relation("recommendationTarget", fields: [recommendedUserId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Role {
  id   String @id @default(uuid())
  name String @unique

  users UserRole[]

  createdAt DateTime @default(now())
}

model UserRole {
  id String @id @default(uuid())

  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, roleId])
}

model Profile {
  id String @id @default(uuid())

  userId   String  @unique
  fullName String
  bio      String?

  avatarUrl String?

  headline String?

  location String?

  resumeUrl String?

  bannerUrl String?

  availabilityText String?

  githubUrl    String?
  linkedinUrl  String?
  portfolioUrl String?

  collegeId    String?
  departmentId String?

  graduationYear Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  college College? @relation(fields: [collegeId], references: [id])

  department Department? @relation(fields: [departmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([collegeId])
  @@index([departmentId])
}

model CodingProfile {
  id String @id @default(uuid())

  userId String

  platform String
  url      String
  username String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

model College {
  id String @id @default(uuid())

  name    String
  state   String?
  city    String?
  country String?

  website String?
  logoUrl String?

  departments Department[]
  profiles    Profile[]
  educations  Education[]

  normalizedKey String @unique

  communities Community[]

  collegeAdmins CollegeAdmin[]
  cdcrMembers   CdcrMember[]

  // Placement policy configuration
  offerPolicy      CollegeOfferPolicy @default(OPEN)
  allowBacklogsUpTo Int               @default(0) // Max allowed active backlogs (0 = zero tolerance)

  // ── Institutional governance ─────────────────────────────────────────────
  // masterAdminUserId: set when a CollegeRequest is APPROVED by a super-admin.
  // This is the single source of truth for who owns the college dashboard.
  // tpoUserId: Training & Placement Officer — assigned by the master admin.
  // Both are nullable so colleges seeded via catalog import remain unaffected.
  masterAdminUserId String?
  tpoUserId         String?

  masterAdmin User? @relation("CollegeMasterAdmin", fields: [masterAdminUserId], references: [id])
  tpo         User? @relation("CollegeTpo", fields: [tpoUserId], references: [id])

  createdAt       DateTime         @default(now())
  posts           Post[]
  conversations   Conversation[]
  emailDomains    String[]         @default([])
  events          Event[]
  placementDrives PlacementDrive[]
  placementDriveInvites PlacementDriveInvite[]
  adPlacements          AdPlacement[]

  @@index([name])
  @@index([city])
  @@index([state])
  @@index([country])
  @@index([masterAdminUserId])
}

model Department {
  id String @id @default(uuid())

  name String

  // Head of Department (display name, not necessarily a platform user)
  hod String?

  // ── Institutional governance ─────────────────────────────────────────────
  // hodUserId: platform user FK for the HOD role — assigned by the master
  // CollegeAdmin. The @@unique([collegeId, name]) constraint already ensures
  // one HOD per (college, department) combination.
  hodUserId String?
  hodUser   User? @relation("DepartmentHod", fields: [hodUserId], references: [id])

  collegeId String
  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  standardDepartmentId String?
  standardDepartment   StandardDepartment? @relation(fields: [standardDepartmentId], references: [id])

  profiles   Profile[]
  educations Education[]
  cdcrMembers CdcrMember[]

  createdAt     DateTime       @default(now())
  posts         Post[]
  conversations Conversation[]
  communities   Community[]

  @@unique([collegeId, name])
  @@unique([collegeId, standardDepartmentId])
  @@index([collegeId])
  @@index([standardDepartmentId])
  @@index([hodUserId])
}

model Skill {
  id          String      @id @default(uuid())
  name        String      @unique
  category    String?
  searchScore Float       @default(0)
  verified    Boolean     @default(false)
  users       UserSkill[]
  createdAt   DateTime    @default(now())
}

model UserSkill {
  id String @id @default(uuid())

  userId  String
  skillId String

  level SkillLevel @default(BEGINNER)

  // Verification details
  verified           Boolean    @default(false)
  verificationSource String?
  verificationProof  Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, skillId])
  @@index([skillId])
}

model Experience {
  id String @id @default(uuid())

  userId String

  companyId String

  companyName String?

  title String

  employmentType EmploymentType

  startDate DateTime

  endDate DateTime?

  isCurrent Boolean @default(false)

  description String?

  //
  // AUTHENTICITY
  //
  verified Boolean @default(false)

  verificationScore Float @default(0)

  verifiedAt DateTime?

  workEmail String?

  workEmailVerified Boolean @default(false)

  managerName String?

  managerLinkedinUrl String?

  managerEmail String?

  documents Json?

  verificationNotes String?

  verificationMethod String?

  //
  // EXPERIENCE SIGNALS
  //
  skillsUsed Json?

  achievements Json?

  techStack Json?

  teamSize Int?

  //
  // ANTI FRAUD
  //
  suspicious Boolean @default(false)

  flaggedReason String?

  //
  // RELATIONS
  //
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
  @@index([companyId])
  @@index([userId, employmentType, startDate, endDate])
}

model Education {
  id String @id @default(uuid())

  userId String

  collegeId    String?
  departmentId String?

  // Freetext name used when user's college is not yet in the DB
  customCollegeName String?

  degree       String?
  fieldOfStudy String?

  startYear Int?
  endYear   Int?

  current Boolean @default(false)

  // Eligibility fields for placement drives
  cgpa        Float?          // Current CGPA / GPA (self-reported, editable)
  backlogs    Int?  @default(0) // Number of active backlogs/arrears
  currentYear Int?            // e.g. 1=First Year, 2=Second, 3=Third, 4=Final

  // Alumni tracking
  isAlumni         Boolean   @default(false)  // Student has claimed alumni status
  alumniVerified   Boolean   @default(false)  // TPO has verified the alumni claim
  alumniVerifiedAt DateTime?                  // When the claim was approved

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  college College? @relation(fields: [collegeId], references: [id])

  department Department? @relation(fields: [departmentId], references: [id])

  createdAt DateTime @default(now())
  collegeEmail String?
  collegeEmailVerified Boolean @default(false)

  @@index([userId])
  @@index([collegeId])
  @@index([departmentId])
  @@index([userId, collegeId, departmentId])
}

enum CollegeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  DUPLICATE
  VERIFIED // set when a super-admin approves an institutional onboarding request
}

model CollegeRequest {
  id      String               @id @default(uuid())
  userId  String
  name    String
  city    String?
  state   String?
  country String?
  website String?

  // ── Institutional B2B onboarding fields ───────────────────────────────────
  // All fields are optional at the DB level so existing catalog-add requests
  // (which predate this feature) remain valid. The service layer enforces
  // these fields for new institutional onboarding submissions.
  aisheCode              String?  // All India Survey on Higher Education code
  officialEmail          String?  // Primary institutional contact email
  bankAccountNumber      String?  // For placement fee processing
  bankIfscCode           String?  // IFSC code of institutional bank account
  authorityLetterheadDoc String?  // S3 URL of authority letterhead upload

  status    CollegeRequestStatus @default(PENDING)
  adminNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([name])
  @@index([aisheCode])
  @@index([bankAccountNumber])
}

model Post {
  id String @id @default(uuid())

  authorId String

  content String

  type PostType

  announcement Boolean @default(false)
  anonymous    Boolean @default(false)

  discoverable Boolean @default(true)

  resourceUrl  String?
  resourceType String?

  // MEDIA

  media       Json?
  attachments Json?

  thumbnailUrl String?
  mediaUrl     String?

  tags PostTag[]

  mentions String[]

  // CONTEXT
  collegeId    String?
  departmentId String?
  communityId  String?

  projectId   String?
  hackathonId String?

  // VISIBILITY
  visibility PostVisibility @default(PUBLIC)

  featured Boolean @default(false)

  pinned Boolean @default(false)

  archivedAt DateTime?
  deletedAt  DateTime?

  // ANALYTICS
  shareCount Int @default(0)

  saveCount Int @default(0)

  commentsCount Int @default(0)
  likesCount    Int @default(0)

  impressionCount Int @default(0)

  engagementScore Float @default(0)

  trendingScore Float @default(0)

  // RELATIONS

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  college College? @relation(fields: [collegeId], references: [id])

  department Department? @relation(fields: [departmentId], references: [id])

  project Project? @relation(fields: [projectId], references: [id])

  hackathon Hackathon? @relation(fields: [hackathonId], references: [id])

  comments Comment[]
  likes    Like[]
  shares   PostShare[]
  savedBy  SavedPost[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  community Community? @relation(fields: [communityId], references: [id])

  @@index([authorId])
  @@index([collegeId])
  @@index([departmentId])
  @@index([createdAt])
  @@index([trendingScore])
  @@index([communityId])
}

model PostShare {
  id String @id @default(uuid())

  postId String
  userId String

  caption String?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model SavedPost {
  id String @id @default(uuid())

  userId String
  postId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model PostTag {
  id String @id @default(uuid())

  postId String

  tag String

