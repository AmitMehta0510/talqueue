{
  "name": "server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=4096 ts-node-dev --respawn -r tsconfig-paths/register src/server.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/server.js",
    "seed:companies": "ts-node -r tsconfig-paths/register src/modules/companies/scraper/runManualSeed.ts",
    "seed:jobs": "ts-node -r tsconfig-paths/register -r dotenv/config scripts/runners/runManualJobSeed.ts",
    "seed:roles": "ts-node -r tsconfig-paths/register prisma/seedRole.ts",
    "seed:skills": "ts-node -r tsconfig-paths/register prisma/seedSkills.ts",
    "seed:departments": "ts-node -r tsconfig-paths/register prisma/seedStandardDepartments.ts",
    "seed:sandbox": "ts-node -r tsconfig-paths/register prisma/seedStagingSandbox.ts",
    "seed:interviews": "ts-node -r tsconfig-paths/register prisma/seedInterviews.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@aws-sdk/client-s3": "^3.1073.0",
    "@aws-sdk/s3-request-presigner": "^3.1073.0",
    "@elastic/elasticsearch": "^8.15.0",
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^10.65.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/swagger-ui-express": "^4.1.8",
    "axios": "^1.16.1",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.80.0",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^6.19.3",
    "puppeteer": "^25.1.0",
    "razorpay": "^2.9.8",
    "slugify": "^1.6.9",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "tsconfig-paths": "^4.2.0",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.2",
    "@types/pg": "^8.20.0",
    "@types/pino-http": "^5.8.4",
    "cross-env": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.17",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "vitest-mock-extended": "^4.0.0"
  }
}
